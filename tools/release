#!/usr/bin/env ruby
# frozen_string_literal: true
# Usage: tools/release [--minor | --major] [--dry-run]
# Release from a clean, pushed main: run the tests, then bump and push (tools/bump).
# Registration is a separate step: see tools/publish.

require 'optparse'

REPO = File.expand_path('..', __dir__).freeze
Dir.chdir(REPO)
bump_args = []
dry_run = false
OptionParser.new do |o|
  o.banner = <<~TEXT
    Usage: tools/release [--minor | --major] [--dry-run]

    Release from a clean main that matches GitHub: run the test suite
    (Pkg.test), then bump the version in Project.toml (patch by default),
    commit "Bump version to X.Y.Z" and push main, verified (tools/bump).

    This pushes to GitHub but does not register the package; registration
    is tools/publish, run rarely and only on request.

  TEXT
  o.summary_width = 14
  o.on('--minor', 'Raise the minor version instead of the patch.') { bump_args << '--minor' }
  o.on('--major', 'Raise the major version instead of the patch.') { bump_args << '--major' }
  o.on('--dry-run', 'Print the next version; change nothing.') { dry_run = true }
end.parse!

if dry_run
  system('ruby', 'tools/bump', '--dry-run', *bump_args) or abort 'bump failed'
  exit
end

abort 'Release from main.' unless `git branch --show-current`.strip == 'main'
abort 'Commit all changes before releasing.' unless `git status --porcelain`.strip.empty?
abort 'Tests failed; release stopped.' unless system('julia', '--project=.', '-e', 'using Pkg; Pkg.test()')
abort 'Release stopped at bump/push; inspect the local state before retrying.' unless system('ruby', 'tools/bump', *bump_args)
