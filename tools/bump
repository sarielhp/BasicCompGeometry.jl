#!/usr/bin/env ruby
# frozen_string_literal: true
# Usage: tools/bump [--minor | --major] [--dry-run]
# Bump the version in Project.toml (patch by default), commit it, and push main
# through tools/push. Registration is a separate step: see tools/publish.

require 'open3'
require 'optparse'

REPO = File.expand_path('..', __dir__).freeze
PROJECT_FILE = File.join(REPO, 'Project.toml').freeze
GITHUB_REPO = 'sarielhp/BasicCompGeometry.jl'
VERSION_PATTERN = /^version\s*=\s*"(\d+)\.(\d+)\.(\d+)"$/.freeze

def run(*command)
  stdout, stderr, status = Open3.capture3(*command, chdir: REPO)
  abort "#{command.first(3).join(' ')} failed:\n#{stderr}\n#{stdout}" unless status.success?
  stdout.strip
end

def git(*args)
  run('git', *args)
end

def github(*args)
  run('gh', *args)
end

level = :patch
dry_run = false
OptionParser.new do |o|
  o.banner = <<~TEXT
    Usage: tools/bump [--minor | --major] [--dry-run]

    Bump the version in Project.toml (patch by default), commit "Bump
    version to X.Y.Z", push main through tools/push, and check that GitHub's
    main is the new commit. Requires a clean main that matches GitHub. It
    runs no tests (tools/release does) and does not register (tools/publish
    does).

  TEXT
  o.summary_width = 14
  o.on('--minor', 'Raise the minor version instead of the patch.') { level = :minor }
  o.on('--major', 'Raise the major version instead of the patch.') { level = :major }
  o.on('--dry-run', 'Print the next version; change nothing.') { dry_run = true }
end.parse!

content = File.read(PROJECT_FILE)
version_match = VERSION_PATTERN.match(content)
abort 'Could not find a semantic version in Project.toml' unless version_match
major, minor, patch = version_match.captures.map(&:to_i)
new_ver = { major: [major + 1, 0, 0], minor: [major, minor + 1, 0], patch: [major, minor, patch + 1] }.fetch(level).join('.')
puts "#{level.to_s.capitalize} release: #{major}.#{minor}.#{patch} -> #{new_ver}"
exit if dry_run

abort 'Release from main.' unless git('branch', '--show-current') == 'main'
abort 'Commit all changes before releasing.' unless git('status', '--porcelain').empty?
run('ruby', '-cw', 'tools/bump')
run('ruby', '-cw', 'tools/push')
run('ruby-audit', '--strict', 'tools/bump', 'tools/push')
github('auth', 'status')
remote_head = github('api', "repos/#{GITHUB_REPO}/git/ref/heads/main", '--jq', '.object.sha')
abort 'Local main must match GitHub main before bumping.' unless git('rev-parse', 'HEAD') == remote_head
content.sub!(VERSION_PATTERN, "version = \"#{new_ver}\"")
File.write(PROJECT_FILE, content)
git('add', 'Project.toml')
git('commit', '-m', "Bump version to #{new_ver}")
commit = git('rev-parse', 'HEAD')
run('ruby', 'tools/push')
published_head = github('api', "repos/#{GITHUB_REPO}/git/ref/heads/main", '--jq', '.object.sha')
abort 'Remote main does not match the release commit.' unless published_head == commit
puts "Pushed #{new_ver} (#{commit}); run tools/publish to register it"
